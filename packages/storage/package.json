{
	"name": "@framefields/storage",
	"version": "2.13.0",
	"private": true,
	"description": "Content-addressed asset storage for framefields projects on any S3-compatible bucket (Cloudflare R2, S3, B2, MinIO).",
	"type": "module",
	"sideEffects": false,
	"license": "Apache-2.0",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"development": "./src/index.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist/**"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit -p .",
		"test": "vitest run",
		"clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
	},
	"devDependencies": {
		"@framefields/tsconfig": "workspace:*",
		"@types/node": "^24.1.0",
		"tsdown": "^0.19.0",
		"typescript": "^5.8.3",
		"vitest": "^4.1.5"
	},
	"dependencies": {
		"aws4fetch": "^1.0.20"
	}
}
