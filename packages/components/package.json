{
	"name": "@framefields/components",
	"version": "2.6.0",
	"private": true,
	"description": "Parametric motion components for framefields. Internal: the toolkit ships in `framefields/components`; components ship as a registry that `framefields add` copies into projects.",
	"type": "module",
	"sideEffects": false,
	"license": "Apache-2.0",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"development": "./src/index.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./toolkit": {
			"types": "./dist/toolkit.d.mts",
			"development": "./src/toolkit.ts",
			"import": "./dist/toolkit.mjs",
			"default": "./dist/toolkit.mjs"
		}
	},
	"files": [
		"dist/**"
	],
	"scripts": {
		"build": "tsdown && tsx scripts/build-meta.ts && tsx scripts/build-registry.ts",
		"dev": "tsdown --watch",
		"clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"meta": "tsx scripts/build-meta.ts",
		"registry": "tsx scripts/build-registry.ts"
	},
	"dependencies": {
		"@framefields/compositions": "workspace:*",
		"@framefields/core": "workspace:*",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@framefields/tsconfig": "workspace:*",
		"@types/node": "^24.1.0",
		"tsdown": "^0.19.0",
		"tsx": "^4.20.3",
		"typescript": "^5.8.3",
		"vitest": "^4.1.11"
	}
}
