{
	"name": "gitframes",
	"version": "2.0.0",
	"private": false,
	"description": "High-performance WebGPU rendering SDK for video composition, Photoshop-grade 2D VFX, audio DSP, and reactive signals. Built for AI Agents.",
	"license": "Apache-2.0",
	"homepage": "https://gatewai.studio.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/gatewai-dev/gitframes.git"
	},
	"bugs": {
		"url": "https://github.com/gatewai-dev/gitframes/issues"
	},
	"keywords": [
		"video",
		"webgpu",
		"motion-graphics",
		"composition",
		"vfx",
		"audio-dsp",
		"signals",
		"headless-rendering"
	],
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"development": "./src/index.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./effects": {
			"types": "./dist/effects/index.d.mts",
			"development": "./src/effects/index.ts",
			"import": "./dist/effects/index.mjs",
			"default": "./dist/effects/index.mjs"
		},
		"./audio": {
			"types": "./dist/audio/index.d.mts",
			"development": "./src/audio/index.ts",
			"import": "./dist/audio/index.mjs",
			"default": "./dist/audio/index.mjs"
		},
		"./signals": {
			"types": "./dist/signals/index.d.mts",
			"development": "./src/signals/index.ts",
			"import": "./dist/signals/index.mjs",
			"default": "./dist/signals/index.mjs"
		},
		"./renderer": {
			"types": "./dist/renderer/index.d.mts",
			"development": "./src/renderer/index.ts",
			"import": "./dist/renderer/index.mjs",
			"default": "./dist/renderer/index.mjs"
		},
		"./fonts": {
			"types": "./dist/fonts/index.d.mts",
			"development": "./src/fonts/index.ts",
			"import": "./dist/fonts/index.mjs",
			"default": "./dist/fonts/index.mjs"
		},
		"./preview": {
			"types": "./dist/preview/index.d.mts",
			"development": "./src/preview/index.ts",
			"import": "./dist/preview/index.mjs",
			"default": "./dist/preview/index.mjs"
		}
	},
	"files": [
		"dist/**"
	],
	"scripts": {
		"build": "tsdown && node scripts/check-dts-bundle.mjs",
		"dev": "tsdown --watch",
		"clean": "rm -rf dist .turbo",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@lottiefiles/dotlottie-web": "^0.74.0",
		"@mediabunny/mp3-encoder": "^1.51.0",
		"@mediabunny/server": "^1.51.0",
		"@napi-rs/webcodecs": "^1.3.1",
		"@resvg/resvg-js": "^2.6.2",
		"d3-format": "^3.1.2",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"dotenv": "^16.4.5",
		"earcut": "^3.2.4",
		"esbuild": "^0.28.1",
		"fontkit": "^2.0.4",
		"gifuct-js": "^2.1.2",
		"gsap": "^3.15.0",
		"mediabunny": "^1.51.0",
		"nanoid": "^5.1.6",
		"onnxruntime-node": "^1.24.0",
		"pino": "^10.3.1",
		"sharp": "^0.35.4",
		"skia-canvas": "^3.0.8",
		"webgpu": "^0.4.0",
		"yoga-layout": "^3.2.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@gitframes/client-utils": "workspace:*",
		"@gitframes/compositions": "workspace:*",
		"@gitframes/core": "workspace:*",
		"@gitframes/node-audio-compressor": "workspace:*",
		"@gitframes/node-audio-delay": "workspace:*",
		"@gitframes/node-audio-fade": "workspace:*",
		"@gitframes/node-audio-noise-gate": "workspace:*",
		"@gitframes/node-audio-parametric-eq": "workspace:*",
		"@gitframes/node-audio-reverb": "workspace:*",
		"@gitframes/node-audio-signal-extractor": "workspace:*",
		"@gitframes/node-blur": "workspace:*",
		"@gitframes/node-color-balance": "workspace:*",
		"@gitframes/node-colorkey": "workspace:*",
		"@gitframes/node-corner-pin": "workspace:*",
		"@gitframes/node-crop": "workspace:*",
		"@gitframes/node-curves": "workspace:*",
		"@gitframes/node-deflicker": "workspace:*",
		"@gitframes/node-displacement-map": "workspace:*",
		"@gitframes/node-film-grain": "workspace:*",
		"@gitframes/node-flip": "workspace:*",
		"@gitframes/node-gradient-map": "workspace:*",
		"@gitframes/node-halftone-screen": "workspace:*",
		"@gitframes/node-high-pass": "workspace:*",
		"@gitframes/node-kenburns": "workspace:*",
		"@gitframes/node-layer-style": "workspace:*",
		"@gitframes/node-levels": "workspace:*",
		"@gitframes/node-liquify": "workspace:*",
		"@gitframes/node-lut": "workspace:*",
		"@gitframes/node-mask-math": "workspace:*",
		"@gitframes/node-mesh-warp": "workspace:*",
		"@gitframes/node-modulate": "workspace:*",
		"@gitframes/node-paint": "workspace:*",
		"@gitframes/node-patch-heal": "workspace:*",
		"@gitframes/node-refine-edge": "workspace:*",
		"@gitframes/node-refraction-caustics": "workspace:*",
		"@gitframes/node-relight-3d": "workspace:*",
		"@gitframes/node-sdk": "workspace:*",
		"@gitframes/node-selective-color": "workspace:*",
		"@gitframes/node-shadows-highlights": "workspace:*",
		"@gitframes/node-signal": "workspace:*",
		"@gitframes/node-signal-gate": "workspace:*",
		"@gitframes/node-signal-math": "workspace:*",
		"@gitframes/node-stereo-panning": "workspace:*",
		"@gitframes/node-tile-offset": "workspace:*",
		"@gitframes/node-unsharp-mask": "workspace:*",
		"@gitframes/node-vignette": "workspace:*",
		"@gitframes/node-vision": "workspace:*",
		"@gitframes/renderer": "workspace:*",
		"@gitframes/renderers": "workspace:*",
		"@gitframes/tensor-webgpu": "workspace:*",
		"@gitframes/tsconfig": "workspace:*",
		"@gitframes/vision": "workspace:*",
		"@gitframes/webgpu-renderers": "workspace:*",
		"@types/d3-format": "^3.0.4",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.2.0",
		"@types/fontkit": "^2.0.9",
		"@types/node": "^24.1.0",
		"tsdown": "^0.19.0",
		"typescript": "^5.8.3",
		"vitest": "4.1.5"
	}
}
