{
	"name": "@gitframes/node-sdk",
	"version": "1.4.2",
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": false,
	"license": "Apache-2.0",
	"description": "SDK for building Gatewai node plugins",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"development": "./index.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./renderer": {
			"types": "./dist/renderer.d.mts",
			"development": "./renderer/index.ts",
			"import": "./dist/renderer.mjs",
			"default": "./dist/renderer.mjs"
		}
	},
	"files": [
		"dist/**"
	],
	"scripts": {
		"build": "tsdown --format esm",
		"dev": "tsdown --format esm --watch",
		"clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
	},
	"devDependencies": {
		"@gitframes/tsconfig": "workspace:*",
		"@types/node": "^24.1.0",
		"@webgpu/types": "^0.1.70",
		"tsdown": "^0.19.0",
		"typescript": "^5.8.3",
		"webgpu": "^0.4.0"
	},
	"peerDependencies": {
		"@gitframes/core": "workspace:*",
		"zod": "^4.3.6"
	},
	"dependencies": {
		"@gitframes/webgpu-renderers": "workspace:*"
	}
}
