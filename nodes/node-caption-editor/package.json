{
	"name": "@gitframes/node-caption-editor",
	"version": "1.2.35",
	"private": false,
	"gitframes": {
		"type": "CaptionEditor",
		"kind": "source"
	},
	"type": "module",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"development": "./src/index.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@gitframes/core": "workspace:*",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@gitframes/tsconfig": "workspace:*",
		"@types/node": "^24.1.0",
		"tsdown": "^0.19.0",
		"typescript": "^5.8.3"
	},
	"publishConfig": {
		"access": "public"
	}
}
