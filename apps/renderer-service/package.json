{
	"name": "@framefields/renderer-service",
	"private": true,
	"version": "2.4.1",
	"type": "module",
	"types": "./dist/src/index.d.ts",
	"files": [
		"dist/src",
		"runpod_worker.py",
		"docker",
		"deploy"
	],
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"default": "./dist/src/index.js"
		}
	},
	"scripts": {
		"dev": "tsx watch --tsconfig tsconfig.dev.json --conditions=development src/index.ts",
		"typecheck": "tsc -b tsconfig.json",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/src/index.js",
		"render": "node dist/src/cli.js",
		"test": "vitest run"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1151.0",
		"@aws-sdk/lib-storage": "^3.1151.0",
		"@hono/node-server": "^1.19.11",
		"dotenv": "^17.0.1",
		"hono": "^4.13.7",
		"pino": "^10.3.1",
		"semver": "^7.8.5",
		"tsx": "^4.21.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@framefields/renderer": "workspace:*",
		"@framefields/tsconfig": "workspace:*",
		"@types/node": "^24.1.0",
		"@types/semver": "^7.8.0",
		"framefields": "workspace:*",
		"typescript": "^5.8.3",
		"vitest": "^4.1.5"
	}
}
