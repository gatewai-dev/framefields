{
	"name": "@framefields/core",
	"version": "2.0.5",
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": false,
	"license": "Apache-2.0",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"development": "./src/index.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist/**"
	],
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"dev": "tsdown --watch",
		"clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
	},
	"devDependencies": {
		"@framefields/tsconfig": "workspace:*",
		"@webgpu/types": "^0.1.70",
		"tsdown": "^0.19.0",
		"typescript": "^5.8.3",
		"vitest": "^4.1.5"
	},
	"dependencies": {
		"nanoid": "^5.1.6",
		"zod": "^4.3.6"
	}
}
