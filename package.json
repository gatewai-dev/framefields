{
	"private": true,
	"version": "2.0.2",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"test": "turbo run test",
		"clean": "pnpm -r exec rm -rf dist .turbo",
		"check:deps": "pnpm -r exec node -e \"console.log(process.cwd())\"",
		"check:plugins": "node scripts/validate-agent-plugin.mjs",
		"generate:effects": "tsx --conditions development scripts/generate-effects.mts",
		"generate:node-renderers": "tsx scripts/generate-node-renderers.mts",
		"sync:effects-catalog": "node scripts/sync-effects-catalog.mjs",
		"sync:readme": "node scripts/sync-readme.mjs",
		"changeset": "changeset",
		"version:packages": "changeset version && node scripts/sync-plugin-version.mjs",
		"sync:plugin-version": "node scripts/sync-plugin-version.mjs",
		"pack:plugin": "rm -f framefields-plugin.zip && cd plugins/framefields && zip -qrX ../../framefields-plugin.zip . -x '*.DS_Store'",
		"release:local": "turbo run build && pnpm -r publish --access public --no-git-checks",
		"release:local:dry-run": "turbo run build && pnpm -r publish --dry-run --access public --no-git-checks",
		"release:framefields": "turbo run build && pnpm --filter framefields publish --access public --no-git-checks",
		"release:framefields:dry-run": "pnpm --filter framefields publish --dry-run --access public --no-git-checks"
	},
