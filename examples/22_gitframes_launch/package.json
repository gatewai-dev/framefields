{
	"name": "@gitframes/example-22-gitframes-launch",
	"version": "1.3.1",
	"private": true,
	"type": "module",
	"scripts": {
		"fonts": "tsx src/fetch-fonts.ts",
		"song": "tsx src/generate-song.ts",
		"images": "tsx src/generate-images.ts",
		"precomp": "tsx src/precomp.ts",
		"render": "tsx src/render.ts",
