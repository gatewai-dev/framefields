{
	"name": "@framefields/vision-sam",
	"description": "Prompted video tracking for framefields: SAM 2.1 Tiny / Small and SAM 3 (text selection, several objects). SAM 3's model weights, downloaded at runtime, are under Meta's SAM License.",
	"version": "2.9.2",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"license": "Apache-2.0",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"development": "./src/index.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist/**",
		"NOTICE.md"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"clean": "rm -rf .turbo node_modules dist",
		"test": "vitest run",
		"test:sam2": "FRAMEFIELDS_SAM2_E2E=1 vitest run src/sam2/sam2.e2e.test.ts",
		"test:sam3": "FRAMEFIELDS_SAM3_E2E=1 vitest run src/sam3/sam3.e2e.test.ts"
	},
	"peerDependencies": {
		"onnxruntime-web": "^1.24.0"
	},
	"peerDependenciesMeta": {
		"onnxruntime-web": {
			"optional": true
		}
	},
	"dependencies": {
		"@framefields/core": "workspace:*",
		"@framefields/vision": "workspace:*",
		"@huggingface/tokenizers": "^0.2.0",
		"onnxruntime-node": "^1.24.0",
		"webgpu": "^0.4.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@framefields/tsconfig": "workspace:*",
		"@types/node": "^24.1.0",
		"tsdown": "^0.19.0",
		"typescript": "^5.8.3",
		"vitest": "^4.1.5"
	}
}
