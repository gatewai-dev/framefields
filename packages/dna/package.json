{
	"name": "@framefields/dna",
	"version": "2.14.0",
	"private": true,
	"description": "Read DNA character files (MetaHuman-compatible rigs: joints, meshes, skin weights, blend shapes, rig behavior) and turn them into GLB characters.",
	"type": "module",
	"sideEffects": false,
	"license": "Apache-2.0",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"development": "./src/index.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist/**"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit -p .",
		"test": "vitest run",
		"clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
	},
	"dependencies": {
		"@framefields/forge": "workspace:*"
	},
	"devDependencies": {
		"@framefields/tsconfig": "workspace:*",
		"@framefields/webgpu-renderers": "workspace:*",
		"@types/node": "^24.1.0",
		"gltf-validator": "2.0.0-dev.3.10",
		"tsdown": "^0.19.0",
		"typescript": "^5.8.3",
		"vitest": "^4.1.5"
	}
}
