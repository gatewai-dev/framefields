{
	"name": "@framefields/renderer",
	"version": "2.0.2",
	"private": false,
	"type": "module",
	"sideEffects": false,
	"license": "Apache-2.0",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"development": "./src/index.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./offscreen-gl-polyfill": {
			"types": "./dist/offscreen-canvas.d.mts",
			"development": "./src/offscreen-canvas.ts",
			"import": "./dist/offscreen-canvas.mjs",
			"default": "./dist/offscreen-canvas.mjs"
		}
	},
	"files": [
		"dist/**"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "node dist/test-runner.mjs",
		"test:benchmark": "vitest run src/tests/benchmark.test.ts",
		"test:vitest": "vitest run",
		"clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
	},
	"devDependencies": {
		"@framefields/tsconfig": "workspace:*",
		"@types/node": "^24.1.0",
		"tsdown": "^0.19.0",
		"tsx": "^4.20.3",
		"typescript": "^5.8.3",
		"vitest": "4.1.5"
	},
