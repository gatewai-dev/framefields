{
	"name": "@framefields/example-43-collage-explainer",
	"version": "2.16.0",
	"private": true,
	"type": "module",
	"scripts": {
		"assets": "tsx src/fetch-fonts.ts",
		"brief": "tsx --conditions=development src/brief.ts",
		"generate": "tsx --conditions=development src/generate.ts",
		"render": "tsx src/render.ts",
		"render:src": "tsx --tsconfig tsconfig.dev.json --conditions=development src/render.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit -p ."
	},
	"dependencies": {
		"framefields": "workspace:*"
	},
	"devDependencies": {
		"@framefields/tsconfig": "workspace:*",
		"@types/node": "^24.1.0",
		"tsx": "^4.20.3",
		"typescript": "^5.8.3",
		"vitest": "^4.1.5"
	}
}
