{
	"name": "@gitframes/media",
	"version": "1.3.1",
	"private": false,
	"type": "module",
	"sideEffects": false,
	"license": "APGL-3.0",
	"module": "./dist/server.mjs",
	"types": "./dist/server.d.mts",
	"exports": {
		"./server": {
			"types": "./dist/server.d.mts",
			"development": "./server/index.ts",
			"import": "./dist/server.mjs",
			"default": "./dist/server.mjs"
		},
		".": {
			"types": "./dist/server.d.mts",
			"development": "./server/index.ts",
			"import": "./dist/server.mjs",
			"default": "./dist/server.mjs"
		}
	},
	"files": [
		"dist/**"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "vitest run",
		"clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
	},
	"devDependencies": {
		"@gitframes/tsconfig": "workspace:*",
		"@types/node": "^24.1.0",
		"jsdom": "^29.1.0",
		"tsdown": "^0.19.0",
		"typescript": "^5.8.3",
		"vitest": "^4.1.5",
		"vitest-mock-extended": "^4.0.0"
	},
	"dependencies": {
		"@gitframes/core": "workspace:*",
		"@gitframes/server-utils": "workspace:*",
		"file-type": "^21.3.0",
		"fflate": "^0.8.2",
		"sharp": "^0.34.5"
	},
	"peerDependencies": {
		"inversify": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
