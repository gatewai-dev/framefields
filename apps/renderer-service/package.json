{
	"name": "@framefields/renderer-service",
	"private": true,
	"version": "2.1.3",
	"type": "module",
	"types": "./dist/src/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"default": "./dist/src/index.js"
		}
	},
	"scripts": {
		"dev": "tsx watch --tsconfig tsconfig.dev.json --conditions=development src/index.ts",
		"typecheck": "tsc -b tsconfig.json",
		"build": "tsc -b tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@framefields/core": "workspace:*",
		"@framefields/renderer": "workspace:*",
		"@framefields/server-utils": "workspace:*",
		"@hono/node-server": "^1.19.11",
		"dotenv": "^17.0.1",
		"hono": "^4.13.7",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "^24.1.0",
		"tsx": "^4.20.3",
		"typescript": "^5.8.3",
		"vitest": "^4.1.5",
		"@framefields/tsconfig": "workspace:*"
	}
}
