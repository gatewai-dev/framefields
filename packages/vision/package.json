{
	"name": "@gitframes/vision",
	"description": "On-device vision for gitframes: RTMDet-Ins detection + instance masks, RTMO pose, and Selfie Segmenter mattes over ONNX Runtime.",
	"version": "1.3.0",
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": false,
	"license": "Apache-2.0",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"development": "./src/index.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./schemas": {
			"types": "./dist/schemas.d.mts",
			"development": "./src/schemas.ts",
			"import": "./dist/schemas.mjs",
			"default": "./dist/schemas.mjs"
		},
		"./web": {
			"types": "./dist/web.d.mts",
			"development": "./src/web.ts",
			"import": "./dist/web.mjs",
			"default": "./dist/web.mjs"
		}
	},
	"files": [
		"dist/**"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
		"test": "vitest run",
		"test:models": "GITFRAMES_VISION_E2E=1 vitest run src/models.e2e.test.ts"
	},
	"peerDependencies": {
		"onnxruntime-web": "^1.24.0"
	},
	"peerDependenciesMeta": {
		"onnxruntime-web": {
			"optional": true
		}
	},
	"dependencies": {
		"@gitframes/core": "workspace:*",
		"@gitframes/tensor-webgpu": "workspace:*",
		"onnxruntime-node": "^1.24.0",
		"webgpu": "^0.4.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@gitframes/tsconfig": "workspace:*",
		"@types/node": "^24.1.0",
		"skia-canvas": "^3.0.8",
		"tsdown": "^0.19.0",
		"typescript": "^5.8.3",
		"vitest": "^4.1.5"
	}
}
